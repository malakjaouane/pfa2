# ============================================================
# Variables d'environnement du portefeuille d'initiatives
# ------------------------------------------------------------
# Copiez ce fichier en « .env » et adaptez les valeurs.
#
#   - En développement local (profil « dev », le défaut), ces
#     valeurs sont OPTIONNELLES : application.yml fournit les
#     mêmes valeurs par défaut.
#   - Hors profil dev (recette, production, conteneur), le
#     backend REFUSE de démarrer si le secret JWT ou le mot de
#     passe de base de données sont encore ceux par défaut
#     (voir VerificationSecrets). docker-compose.yml refuse
#     lui aussi de démarrer si DB_PASSWORD / JWT_SECRET sont
#     absents du fichier .env.
# ============================================================

# --- Base de données MySQL -----------------------------------
# En conteneur : DB_URL jdbc:mysql://mysql:3306/... (déjà fourni par
# docker-compose.yml, pas besoin de le redéfinir ici).
DB_NAME=portefeuille_initiatives
DB_PORT=3306
DB_URL=jdbc:mysql://127.0.0.1:3306/portefeuille_initiatives?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=pfa_user
DB_PASSWORD=pfa2026
# Requis uniquement pour initialiser le conteneur MySQL.
DB_ROOT_PASSWORD=changez-ce-mot-de-passe-root

# --- Sécurité JWT --------------------------------------------
# Clé de signature HS256 : au minimum 32 octets (256 bits).
# JAMAIS la valeur par défaut connue (le démarrage est refusé hors profil
# dev) — générez une vraie clé aléatoire et collez-la ici :
#   openssl rand -base64 48
JWT_SECRET=REMPLACEZ-CETTE-CLE-openssl-rand-base64-48
# Durée de validité du jeton en millisecondes (28800000 = 8 heures).
JWT_EXPIRATION_MS=28800000

# --- Compte administrateur initial ---------------------------
# Créé au premier démarrage si la base est vide (voir DataInitializer).
# Changez le mot de passe livré : il n'est plus codé en dur dans le code.
ADMIN_EMAIL=admin@it6.ma
ADMIN_PASSWORD=changez-ce-mot-de-passe-admin

# --- Sécurité applicative ------------------------------------
# Cache de sessions (millisecondes). Le compte et ses permissions sont
# rechargés à chaque requête ; ce cache évite une requête SQL par appel.
# Toute modification d'un compte ou d'un rôle vide le cache immédiatement.
SESSION_CACHE_MS=30000
# Limitation des tentatives de connexion (anti force brute) :
# 5 échecs pour un même compte, 20 pour une même adresse IP,
# sur une fenêtre glissante de 15 minutes → réponse HTTP 429.
# (Paramètres du backend : app.securite.tentatives.*)

# --- CORS ----------------------------------------------------
# Origines autorisées (motifs, séparés par des virgules).
# En local, les défauts suffisent (http://localhost:*,http://127.0.0.1:*).
# En production, déclarer explicitement le domaine déployé :
#   CORS_ALLOWED_ORIGINS=https://portefeuille.mon-domaine.ma
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# --- Assistant IA (Anthropic Claude) -------------------------
# OPTIONNEL : sans clé, la page /assistant affiche « indisponible »
# gracieusement et l'API répond 503 avec un message explicite.
# Créez une clé sur console.anthropic.com (Settings → API Keys) puis
# collez-la ici. .env est ignoré par git : la clé n'est JAMAIS committée.
ANTHROPIC_API_KEY=
# Modèle utilisé (défaut : claude-haiku-4-5, rapide et économique).
# Toute valeur du catalogue Anthropic est acceptée.
ANTHROPIC_MODELE=claude-haiku-4-5
# Interrupteur global (kill switch) : false désactive l'assistant même
# si une clé est présente — servir d'un incident sans toucher au code.
IA_ACTIF=true
# --- Format de l'appel IA (alternative sans clé) --------------
# IA_FORMAT = anthropic (défaut, API Anthropic) ou openai (compatible
# OpenAI : Ollama local, LM Studio, Groq, Mistral, OpenRouter…).
# En mode openai, AUCUNE clé n'est requise pour un service local :
#   IA_FORMAT=openai
#   IA_BASE_URL=http://host.docker.internal:11434   (Ollama en local)
#   IA_MODELE=qwen2.5:3b
IA_FORMAT=anthropic
IA_BASE_URL=https://api.anthropic.com
IA_MODELE=claude-haiku-4-5
IA_MAX_TOKENS=1024

# --- Front (docker-compose.yml) ------------------------------
FRONT_PORT=80
